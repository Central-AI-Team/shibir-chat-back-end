[Unit]
Description=ShibirGPT
After=network.target

[Service]
Type=simple
User=lab
Group=lab
WorkingDirectory=/home/lab/apps/shibirgpt
#Environment="PATH=/path/to/your/project/venv/bin"
ExecStart=/path/to/your/project/venv/bin/   
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastapi-app

[Install]
WantedBy=multi-user.target