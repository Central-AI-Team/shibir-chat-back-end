# Required
GEMINI_API_KEY=your-gemini-api-key

# Required -- ingest and note generation both read pages/articles from Postgres.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shibir_chat

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION_NAME=documents_bge_m3
# TOP_K=5
# FETCH_K=25
# MIN_SIMILARITY=0.25
# MIN_RERANK_SCORE=0.5
# TARUN_DB_PATH=data/Tarun_Associate.db
# NOBIN_DB_PATH=data/Nobin_Associate.db
# HOST=0.0.0.0
# PORT=9200
