# Required -- used by generator.py / query_rewriter.py / note_service.py.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-5-mini

# Required -- ingest and note generation both read pages/articles from Postgres.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shibir_chat

# Optional overrides (defaults shown)
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION_NAME=documents_bge_m3
# TOP_K=5
# FETCH_K=25
# MIN_SIMILARITY=0.25
# MIN_RERANK_SCORE=0.5
# TARUN_DB_PATH=data/Tarun_Associate.db
# NOBIN_DB_PATH=data/Nobin_Associate.db
# HOST=0.0.0.0
# PORT=9200

# Required only if a task in MODEL_BY_TASK below is routed to a Groq model.
# GROQ_API_KEY=your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Per-task model routing (app/core/llm.get_model() / complete()). JSON dict, keys are
# task names: intent, rewrite, persona, qa, note, suggest, roleplay. Empty by default --
# do not hand-fill without first running scripts/eval_task_routing.py for that task; see
# app/core/config.py's comment on this field for why.
# rewrite -> openai/gpt-oss-20b: decided 2026-09-23 via scripts/eval_task_routing.py vs
# gpt-5-mini on chat_intent_test_questions.json (25 Qs) + retrieval_eval_questions.json
# (40 Qs, parse-failure only): intent accuracy unchanged (95.24%), rewrite parse-failure
# rate 10.00% vs baseline 22.50% (better, not worse), avg latency 9.1s vs 22.7s.
# MODEL_BY_TASK={"rewrite": "openai/gpt-oss-20b"}

# --- LLM tracing with Langfuse (optional, OFF by default) ---
# Leave both keys empty and nothing changes: no tracing, no extra latency,
# the langfuse SDK is never even imported. Set both to turn it on -- point
# them at a self-hosted Langfuse (recommended) or Langfuse Cloud. See the
# README section "LLM tracing with Langfuse (self-hosted)".
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_ENABLED=true          # master switch; set false to disable even with keys set
# LANGFUSE_CAPTURE_IO=true       # false -> redact all query/excerpt/prompt/answer text in traces
# LANGFUSE_RELEASE=              # optional build marker, e.g. a git short sha
# LANGFUSE_ENVIRONMENT=development  # set to "production" on the deployed box
