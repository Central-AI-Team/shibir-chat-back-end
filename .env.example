# Shibir Chat Back-End configuration.
# Copy to .env and fill in. Only OPENAI_API_KEY and DATABASE_URL are required;
# every commented line shows the default. Full reference: CLAUDE.md §11.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
# SQLAlchemy DSN (not usable with psql directly).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shibir_chat

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# OPENAI_MODEL=gpt-5-mini
# LLM_REQUEST_TIMEOUT_SECONDS=90   # per LLM call; for streaming, the max gap between chunks
# LLM_MAX_RETRIES=1                # SDK retries per call (worst case = (1 + N) * timeout)

# Per-task model routing, JSON. Tasks: intent, rewrite, roleplay_meta, qa, note, suggest, roleplay.
# Empty = every task uses OPENAI_MODEL. Only add an entry after scripts/eval_task_routing.py
# shows no regression (see docs/evaluation.md). Note: routing "rewrite" to
# openai/gpt-oss-20b was tried and reverted on 2026-09-24 -- it misspelled key Banglish terms
# in 7/18 repeated rewrites and broke retrieval.
# MODEL_BY_TASK={}

# Latency knobs (CLAUDE.md §5). Defaults shown.
# OPENAI_REASONING_EFFORT=minimal  # gpt-5* only; empty = API default (medium, slower)
# OPENAI_REASONING_EFFORT_BY_TASK={"intent":"low","rewrite":"low"}  # "minimal" misrouted intents and corrupted Banglish rewrites in testing
# MAX_TOKENS_QA=2500               # completion-token caps when a call passes no budget
# MAX_TOKENS_SUGGESTION=2000
# MAX_TOKENS_ROLEPLAY=1500
# MAX_TOKENS_NOTE=6000             # ceiling on note_service's own 4000/6000 budgets
# CONTEXT_TOP_K=5                  # excerpts put in the prompt (< TOP_K can desync sources vs. what the model saw)
# ANSWER_SCRIPT_RETRIES=1          # regenerate a QA answer with stray-script letters this many times, then strip
# CONTEXT_MAX_CHARS=1200           # per-excerpt truncation in the prompt
# REWRITE_SKIP_BENGALI_RATIO=0.6   # unused on the request path: the rewrite is skipped only for all-Bengali-script queries
# COMBINE_INTENT_REWRITE=true      # one LLM call for intent + rewrite when both are needed
# QA_HISTORY_TURNS=4               # recent turns shown to the condensation and answer prompts (follow-up questions)
# Mentor mode (docs/roleplay-v2.md). ROLEPLAY_ROLES is a JSON list of
# {id, name_bn, description_bn, tone_bn, default_level}; the four defaults are in app/core/config.py.
# ROLEPLAY_ROLES=[...]
# ROLEPLAY_SUGGESTION_COUNT=3      # follow-up questions after a grounded mentor reply; 0 = no suggestions call
# CONDENSE_MIN_WORDS=6             # a Bengali follow-up this long with no anaphor skips the condensation LLM call
# EMBED_CACHE_SIZE=512             # query-embedding LRU entries; 0 disables
# WARMUP_ON_STARTUP=true           # background embed/search/rerank warm-up at startup
# NOTE_MAP_CONCURRENCY=4           # concurrent map calls when building a chapter note

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# JSON list of browser origins allowed to call the API. Explicit origins only:
# "*" is rejected at startup because the owner cookie needs credentialed CORS.
# The same list is the CSRF allow-list: a POST/DELETE whose Origin is not on it is 403.
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://shibirgpt.potropollob.com"]
# HOST=0.0.0.0                     # not read by run.sh / Dockerfile, which hard-code 0.0.0.0:9200
# PORT=9200

# Anonymous session ownership (shibir_owner cookie). Keep COOKIE_SECURE=true in
# production; set it to false only for plain-http local development, or the
# browser drops the cookie and every request starts a new identity.
# COOKIE_SECURE=false
# Chat history lives in Postgres (conversations / messages; migrations/).
# GUEST_CONVERSATION_CAP=50        # live conversations per guest; the 51st soft-deletes the least-recently-updated
# USER_CONVERSATION_CAP=500        # the same for a logged-in user
# GUEST_HISTORY_RETENTION_DAYS=30  # scripts.purge_history hard-deletes guest and soft-deleted conversations older than this

# Message length caps in characters (after trimming); longer messages get HTTP 413.
# MAX_MESSAGE_CHARS=4000           # every /chat and /chat/stream message
# MAX_NOTE_CHARS=300               # note requests: a request phrase + a book title (the text itself is never summarised)

# In-process rate limits (HTTP 429 + Retry-After). Single worker; they reset on restart.
# RATE_LIMIT_PER_IP_PER_MINUTE=30        # POST /chat + /chat/stream, per client IP
# RATE_LIMIT_PER_OWNER_PER_MINUTE=20     # POST /chat + /chat/stream, per owner cookie
# RATE_LIMIT_READ_PER_IP_PER_MINUTE=120  # GET /conversations, GET .../messages, DELETE, per IP
# NOTE_LIMIT_PER_OWNER_PER_HOUR=3        # note requests (each one map-reduces a whole book)
# DAILY_LLM_REQUEST_BUDGET=5000          # global /chat + /chat/stream requests per UTC day; 0 = unlimited

# Accounts and guests (docs/auth.md). The app creates its tables on startup.
# AUTH_SESSION_IDLE_DAYS=7               # login expires after this much inactivity
# AUTH_SESSION_ABSOLUTE_DAYS=30          # and after this long regardless of activity
# AUTH_REGISTRATION_ENABLED=true         # false = POST /auth/register returns 404
# AUTH_REGISTRATIONS_PER_DAY=200         # global circuit breaker on sign-ups; 0 = unlimited
# GUEST_MESSAGE_LIMIT=5                  # responses per guest (owner cookie), in total; 0 = guests cannot chat
# GUEST_IP_LIMIT_PER_DAY=15              # guest responses per client IP (IPv6: per /64) per 24 h
# USER_DAILY_MESSAGE_LIMIT=100           # per logged-in user per UTC day; 0 = unlimited

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Changing EMBEDDING_MODEL_NAME requires a full reindex AND a new CHROMA_COLLECTION_NAME.
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION_NAME=documents_bge_m3
# TOP_K=5                          # excerpts sent to the LLM
# FETCH_K=25                       # Chroma candidates per query variant, before reranking
# MAX_VARIANTS=4                   # unused: expand_query() returns one Bengali string
# MIN_SIMILARITY=0.25              # cosine pre-filter
# MIN_RERANK_SCORE=0.5             # relevance gate (sigmoid score, 0..1)

# ---------------------------------------------------------------------------
# GPU service (optional)
# ---------------------------------------------------------------------------
# Set GPU_SERVICE_URL to run embedding + reranking on shibir-chat-gpu-service (Modal)
# instead of loading the models locally. The service must serve the same
# EMBEDDING_MODEL_NAME / RERANKER_MODEL_NAME; every response is checked.
# GPU_SERVICE_URL=https://<workspace>--shibir-chat-gpu-service-gpuservice-web.modal.run
# GPU_API_KEY=your-gpu-service-api-key   # sent as X-API-Key
# GPU_TIMEOUT_SECONDS=30
# GPU_COLD_TIMEOUT_SECONDS=120           # first call, or first call after the warm window
# GPU_WARM_WINDOW_SECONDS=240            # keep below the service's Modal scaledown_window (300)
# GPU_BULK_TIMEOUT_SECONDS=300           # floor for ingest's 256-chunk /embed calls
# GPU_MAX_RETRIES=2                      # connection errors / 5xx / 429 only

# ---------------------------------------------------------------------------
# Tracing with Langfuse (optional, off unless both keys are set)
# ---------------------------------------------------------------------------
# See docs/tracing.md. The host variable is LANGFUSE_HOST, not LANGFUSE_BASE_URL.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_ENABLED=true            # master switch
# LANGFUSE_CAPTURE_IO=true         # false = redact all query/excerpt/prompt/answer text
# LANGFUSE_RELEASE=                # optional build marker, e.g. a git short SHA
# LANGFUSE_ENVIRONMENT=development # "production" on the deployed server
# ENABLE_DOCS=true                 # serve /docs, /redoc, /openapi.json (default false; keep off in production)
# ENABLE_TIMING=1                  # local-only per-request latency table (needs app/core/timing_local.py)

# ---------------------------------------------------------------------------
# Evaluation scripts only (not read by the running service)
# ---------------------------------------------------------------------------
# GROQ_API_KEY=your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GENERATION_CANDIDATES=["gpt-5","openai/gpt-oss-120b"]
# GENERATION_JUDGE_MODEL=qwen/qwen3.6-27b
# RAGAS_JUDGE_MODEL=gpt-5-mini
# RAGAS_EMBEDDING_MODEL=text-embedding-3-large

# Legacy: used only by the one-time scripts/migrate_sqlite_to_postgres.py.
# TARUN_DB_PATH=data/Tarun_Associate.db
# NOBIN_DB_PATH=data/Nobin_Associate.db
