# Caddy alternative to deploy/nginx/shibirgpt-api.conf. Use one or the other.
# Caddy gets and renews the Let's Encrypt certificate itself and redirects
# HTTP to HTTPS automatically, so no certificate paths are needed.
#
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

askshibir-back.potropollob.com {
	# Chat messages are short; reject anything bigger before it reaches Python.
	request_body {
		max_size 64KB
	}

	# Second layer: the app already serves no docs unless ENABLE_DOCS=true.
	@docs path /docs /docs/* /redoc /redoc/* /openapi.json
	respond @docs 404

	# Rate limit (~30 requests/minute per IP on /chat and /chat/stream).
	# Not built into Caddy: needs a build with github.com/mholt/caddy-ratelimit
	# (`xcaddy build --with github.com/mholt/caddy-ratelimit`). Uncomment after.
	# Optional: without the plugin you are still protected, because the app
	# enforces its own limits (per IP, per owner cookie, notes per hour, a
	# daily budget; see SECURITY.md). The plugin only rejects floods earlier.
	#
	# order rate_limit before reverse_proxy   <- goes in the global options block
	# @chat path /chat /chat/stream
	# rate_limit @chat {
	# 	zone chat {
	# 		key    {remote_host}
	# 		events 30
	# 		window 1m
	# 	}
	# }
	#
	# Login and registration (~10 requests/minute per IP). The app throttles
	# these too, but every attempt that reaches Python costs one argon2id hash
	# at ~64 MiB, so this is the one place a limit BEFORE the app matters: a
	# flood of logins must be rejected here, not after it has filled the
	# container's RAM. Same plugin, same caveat as above.
	# @auth path /auth/login /auth/register
	# rate_limit @auth {
	# 	zone auth {
	# 		key    {remote_host}
	# 		events 10
	# 		window 1m
	# 	}
	# }

	reverse_proxy 127.0.0.1:9200 {
		# Caddy already sets Host, X-Forwarded-For/-Proto/-Host; X-Real-IP is added.
		header_up X-Real-IP {remote_host}
		# Flush SSE events immediately instead of buffering them.
		flush_interval -1
		transport http {
			read_timeout 300s
		}
	}
}
